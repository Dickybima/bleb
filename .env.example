# API key dari https://zora.co/settings/developer
# Dibutuhkan untuk upload gambar/metadata ke IPFS lewat Zora, dan menaikkan rate limit API.
VITE_ZORA_API_KEY=

# Alamat yang menerima platform referral fee dari setiap koin yang diluncurkan lewat launchpad ini.
# Kosongkan untuk tidak memakai referrer.
VITE_PLATFORM_REFERRER=
