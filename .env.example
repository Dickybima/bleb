# Robinhood Chain RPC (chain id 4663). Default: https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_RPC_URL=

# Pons V2 launch config ID to use. Leave empty to use the first active config on the factory.
VITE_PONS_LAUNCH_CONFIG_ID=

# Optional: API key from https://zora.co/settings/developer.
# Used to pin custom logos to IPFS and for higher Zora API rate limits in the browser.
VITE_ZORA_API_KEY=

# Reown / WalletConnect project ID (free at https://cloud.reown.com).
# Required for mobile (QR) wallets and wallets not installed in the browser.
VITE_WALLETCONNECT_PROJECT_ID=

# Server-side (Vercel Functions /api): Zora API key for the proxy and the Top Zora Profiles ranking.
# Stays on the server, never shipped to the browser. Falls back to VITE_ZORA_API_KEY when empty.
ZORA_API_KEY=

