# RPC Robinhood Chain (chain id 4663). Default: https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_RPC_URL=

# ID launch config Pons V2 yang dipakai. Kosongkan untuk memakai config aktif pertama di factory.
VITE_PONS_LAUNCH_CONFIG_ID=

# Opsional: API key dari https://zora.co/settings/developer.
# Dipakai untuk upload logo custom ke IPFS dan menaikkan rate limit Zora API (data profil & Top Profile).
VITE_ZORA_API_KEY=
