# RPC Robinhood Chain (chain id 4663). Default: https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_RPC_URL=

# ID launch config Pons V2 yang dipakai. Kosongkan untuk memakai config aktif pertama di factory.
VITE_PONS_LAUNCH_CONFIG_ID=

# Opsional: API key dari https://zora.co/settings/developer.
# Dipakai untuk upload logo custom ke IPFS dan menaikkan rate limit Zora API (data profil & Top Profile).
VITE_ZORA_API_KEY=

# Project ID Reown/WalletConnect (gratis di https://cloud.reown.com).
# Dibutuhkan agar wallet HP (QR) dan wallet yang tidak terpasang di browser bisa terhubung.
VITE_WALLETCONNECT_PROJECT_ID=

# Server-side (Vercel Functions /api): API key Zora untuk proxy & ranking Top Profile.
# Disimpan di server, tidak ikut ke browser. Jika kosong, dipakai VITE_ZORA_API_KEY.
ZORA_API_KEY=

# Server-side (Vercel Functions /api/fomo): API key getfomoapi.fun untuk Top Profile Fomo & data profil fomo.family.
# Daftar di https://getfomoapi.fun (layanan pihak ketiga, bukan produk resmi fomo.family).
# Jika kosong, Top Profile Fomo memakai daftar manual di src/data/fomoProfiles.ts.
FOMO_API_KEY=
